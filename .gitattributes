# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly set LF for source code
*.py  text eol=lf
*.js  text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.sh  text eol=lf

# Windows batch files must use CRLF for old cmd.exe compatibility.
# Use -text so Git stores CRLF bytes verbatim in the repository instead of
# normalizing to LF; this avoids checkout-time conversion on old Git clients.
*.bat -text
*.cmd -text

# Binary files - no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.xlsx binary
*.xls  binary
