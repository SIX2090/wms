#!/usr/bin/env bash
# Pre-push hook: enforce main-only branch policy.
#
# AGENTS.md mandates that AI/TRAE must work directly on main and is
# strictly forbidden from creating, switching to, or pushing to any
# other branch (including feature/*, fix/*, chore/*, or trae/*).
#
# This hook blocks:
#   * git push origin <branch>          (local branch != main)
#   * git push origin <local>:<remote>  (remote branch != main)
#   * git push origin <new-branch>      (creating a new remote branch)
#   * git push origin :<branch>         (deleting ANY remote branch, including main)

set -euo pipefail

ALLOWED_REMOTE_BRANCH="main"
ALLOWED_LOCAL_BRANCH="main"

abort() {
    echo "❌ PRE-PUSH BLOCKED: $1" >&2
    echo "   AGENTS.md rule: Branch policy (hard rule, no exceptions)." >&2
    echo "   All commits must go to '${ALLOWED_LOCAL_BRANCH}' directly. No new branches." >&2
    exit 1
}

blocked=0
CI_BASELINE_SHA=""

while read -r local_ref local_sha remote_ref remote_sha; do
    # Accept Windows CRLF pipes while validating the same full commit ID.
    remote_sha="${remote_sha%$'\r'}"
    # Skip empty lines (defensive)
    [ -z "${local_ref}${remote_ref}" ] && continue

    local_branch=""
    remote_branch=""

    if [ -n "${local_ref}" ]; then
        local_branch="${local_ref#refs/heads/}"
    fi
    if [ -n "${remote_ref}" ]; then
        remote_branch="${remote_ref#refs/heads/}"
    fi

    # Block deletion of main (local_ref 为空表示删除远程分支)。
    # 允许删除非 main 远程分支（如 trae/agent-* 残留）；仅 main 禁止删除，
    # 防止误删 main 丢失全部历史。除 main 外禁止创建/推送任何新分支。
    if [ -z "${local_ref}" ] && [ -n "${remote_ref}" ] && [ "${remote_sha}" = "0000000000000000000000000000000000000000" ]; then
        if [ "${remote_branch}" = "main" ]; then
            echo "❌ PRE-PUSH BLOCKED: deleting remote branch 'main' is not allowed." >&2
            echo "   main 是唯一主干分支，禁止删除；非 main 分支允许删除。" >&2
            blocked=1
            continue
        fi
    fi

    # Block local branch push when not on main
    if [ -n "${local_branch}" ] && [ "${local_branch}" != "${ALLOWED_LOCAL_BRANCH}" ]; then
        echo "❌ PRE-PUSH BLOCKED: pushing local branch '${local_branch}' is not allowed." >&2
        echo "   Only '${ALLOWED_LOCAL_BRANCH}' may be pushed." >&2
        blocked=1
        continue
    fi

    # Block any remote branch other than main
    if [ -n "${remote_branch}" ] && [ "${remote_branch}" != "${ALLOWED_REMOTE_BRANCH}" ]; then
        echo "❌ PRE-PUSH BLOCKED: target remote branch '${remote_branch}' is not allowed." >&2
        echo "   Only '${ALLOWED_REMOTE_BRANCH}' is permitted on the remote." >&2
        blocked=1
        continue
    fi
    # The pre-push protocol supplies the *remote* ref before this push.
    # Local SHA is untested code and must never be used as the baseline gate.
    if [ "${remote_ref}" = "refs/heads/main" ]; then
        if [[ ! "${remote_sha}" =~ ^[0-9a-fA-F]{40}$ ]] || [ "${remote_sha}" = "0000000000000000000000000000000000000000" ]; then
            echo "❌ PRE-PUSH BLOCKED: 远端main基线SHA缺失或非法，无法核实CI目标。" >&2
            blocked=1
            continue
        fi
        if [ -n "${CI_BASELINE_SHA}" ] && [ "${CI_BASELINE_SHA}" != "${remote_sha}" ]; then
            echo "❌ PRE-PUSH BLOCKED: 多条main更新的远端基线不一致。" >&2
            blocked=1
            continue
        fi
        CI_BASELINE_SHA="${remote_sha}"
    fi
done

if [ "${blocked}" -ne 0 ]; then
    echo "" >&2
    echo "👉 To comply: switch to '${ALLOWED_LOCAL_BRANCH}' and re-push, e.g.:" >&2
    echo "     git checkout ${ALLOWED_LOCAL_BRANCH}" >&2
    echo "     git push origin ${ALLOWED_LOCAL_BRANCH}" >&2
    exit 1
fi

# No refs are being written: allow a no-op push without network CI checks.
if [ -z "${CI_BASELINE_SHA}" ]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# F2.8：CI 全绿门禁（AGENTS.md §三）—— 远端待更新基线的最新运行未证实全绿则阻断 push。
#
# 门禁检查三个工作流：WMS CI / WMS AI Verification / Android APK Build。
# WMS_SKIP_CI_GATE=1仅用于已核实同一SHA全绿并记录替代证据、而脚本查询故障的单次push。
# 说明：本 hook 仅拦截本地 git push；走 GitHub API（MCP push_files）的推送不经过它。
# ---------------------------------------------------------------------------
if [ "${WMS_SKIP_CI_GATE:-0}" = "1" ]; then
    echo "⚠️  WMS_SKIP_CI_GATE=1：本次使用已记录的同一基线SHA全绿替代证据；未核实不得使用此开关。" >&2
else
    # BUG-2026-10-17-007：Windows 上 `python3` 常是 Microsoft Store 的 0 字节别名，
    # `command -v` 能找到它，但执行即失败（退出码 9009）。原逻辑据此判定"门禁未通过"，
    # 于是一台本该能正常推送的 Windows 机器上**所有 push 都被误拦**。
    # 改为像 pre-commit 一样做真实执行验证：解释器必须能跑起 `import sys` 才采用。
    CI_PY=""
    for cand in python3 python py; do
        if command -v "${cand}" >/dev/null 2>&1 && "${cand}" -c "import sys" >/dev/null 2>&1; then
            CI_PY="${cand}"
            break
        fi
    done
    if [ -z "${CI_PY}" ]; then
        echo "❌ PRE-PUSH BLOCKED: 找不到可用的 python，无法执行 CI 全绿门禁。" >&2
        echo "   若 python3 指向 Microsoft Store 的 0 字节别名，请关闭该执行别名或安装 Python 3，" >&2
        echo "   并把真实解释器加入 PATH（本仓库要求能执行 python -c \"import sys\"）。" >&2
        echo "   查询故障且同一SHA已全部核实并记录替代证据时，才可单次WMS_SKIP_CI_GATE=1" >&2
        exit 1
    fi
    if ! "${CI_PY}" scripts/check_ci_green.py --quiet --target-sha "${CI_BASELINE_SHA}"; then
        echo "" >&2
        echo "❌ PRE-PUSH BLOCKED: CI 门禁未通过（远端基线 ${CI_BASELINE_SHA} 未确认全绿）。" >&2
        echo "   运行中请等结果，实际失败先修绿，查询故障请通过已连接GitHub工具核实同一SHA。" >&2
        echo "   查询故障且同一SHA已全部核实并记录替代证据时，才可单次WMS_SKIP_CI_GATE=1" >&2
        exit 1
    fi
fi

exit 0
