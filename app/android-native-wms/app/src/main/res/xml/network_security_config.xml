<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 安全基线：release 默认禁止明文 HTTP，仅放行下方白名单域名/IP。
         内网仓库服务器地址为局域网 IP，network_security_config 的 <domain>
         只支持具体域名/IP、不支持 CIDR 网段，故无法对任意网段做白名单。
         约定：
         - debug 构建放开明文（便于真机连局域网 HTTP 联调）；
         - release 构建仅放行白名单内的主机，其余一律 REQUIRE HTTPS，
           需要访问的局域网 IP 请显式加入下方白名单。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 已知需要明文 HTTP 的主机白名单（局域网 IP 或内网域名） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- debug 构建放开明文，便于局域网 HTTP 联调 -->
    <debug-overrides>
        <base-config cleartextTrafficPermitted="true">
            <trust-anchors>
                <certificates src="system" />
            </trust-anchors>
        </base-config>
    </debug-overrides>
</network-security-config>