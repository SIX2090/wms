<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 内网仓库工具，服务器地址为局域网 IP，统一放行明文 HTTP。
         注意：<domain> 只支持具体域名/IP，不支持 CIDR 网段（/8、/12、/16），
         故此处直接放行全部明文流量，避免真机通过局域网 HTTP 被系统拦截。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>